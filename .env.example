# ============================================================================
# Polyglot — configuration
# Copy to `.env` and fill in. Every value below has a working default except
# ANTHROPIC_API_KEY and JWT_SECRET_KEY.
# ============================================================================

# --- Application ---------------------------------------------------------
APP_NAME="Polyglot"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false                   # true in production (structured logs)
CORS_ORIGINS=["http://localhost:8501","http://localhost:3000"]

# --- Security ------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Anthropic / LLM -----------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=anthropic           # anthropic | echo (echo = offline stub for tests)
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=4096
LLM_EFFORT=low                   # low | medium | high | xhigh | max
LLM_THINKING=adaptive            # adaptive | disabled  (see README: effort cap)
LLM_PROMPT_CACHING=true

# --- Database ------------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./polyglot.db
# PostgreSQL + pgvector (docker compose provides this):
# DATABASE_URL=postgresql+asyncpg://polyglot:polyglot@localhost:5432/polyglot

# --- Redis ---------------------------------------------------------------
# Leave empty to use the in-process fallback cache / rate limiter.
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60           # requests ...
RATE_LIMIT_WINDOW_SECONDS=60     # ... per window, per user (or per IP if anon)

# --- Uploads -------------------------------------------------------------
STORAGE_DIR=./storage
MAX_IMAGE_BYTES=5242880          # 5 MiB
MAX_AUDIO_BYTES=26214400         # 25 MiB
MAX_DOCUMENT_BYTES=20971520      # 20 MiB

# --- Speech --------------------------------------------------------------
STT_MODEL=small                  # faster-whisper size: tiny|base|small|medium|large-v3
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
TTS_DEFAULT_VOICE=               # empty = auto-pick a voice for the reply language

# --- Retrieval-Augmented Generation --------------------------------------
RAG_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_MIN_SCORE=0.15
